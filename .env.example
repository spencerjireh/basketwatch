# Two files at the repo root, and no per-app copies - a second copy per app is
# how drizzle-kit silently ran with no DATABASE_URL for a day.
#
#     .env       what you are working against. LOCAL by default.
#     .env.prod  the deployed database. Read only by `just db-backup` and by
#                anything you deliberately point at production. Gitignored.
#
#     cp .env.example .env
#
# The default is local on purpose. A command run without thinking should hit
# localhost; reaching production should require naming the file that says so.
#
# Bright Data
BRIGHTDATA_API_KEY=
BRIGHTDATA_WEBHOOK_SECRET=

# Anthropic (heal prompt composition)
ANTHROPIC_API_KEY=

# Ops actions that cost money or change the fleet (manual runs, heal triggers).
#
# The API only. The dashboard must never hold this: it has no login, so a token
# in the web container turns every visitor into an operator using our
# credentials. Prod compose passes it to `api` and not to `web`, and turbo does
# not forward it to the web dev server either.
#
# The guard fails closed: unset means those endpoints 401 and manual runs are
# off, which is a safe default rather than a broken one. Generate with
# `openssl rand -hex 32` and set it in the repo-root .env and in Coolify.
OPS_TOKEN=

# API logging
LOG_LEVEL=info

# Database (local dev, matches docker-compose.dev.yml at the repo root)
DATABASE_URL=postgres://basketwatch:basketwatch@localhost:5432/basketwatch

# The deployed database goes in .env.prod, not here. Use the public port and
# the password from the Coolify env; see docs/deploy.md.
#
# The raw VPS IP, not a hostname: *.spencerjireh.com is Cloudflare-proxied and
# the proxy does not forward Postgres traffic.
#
#     # .env.prod
#     DATABASE_URL=postgres://basketwatch:<password>@152.53.136.253:55432/basketwatch
#     POSTGRES_PASSWORD=<password>

# Alerts
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Prod compose (Coolify env). POSTGRES_PASSWORD has no default and the deploy
# fails without it; generate one with: openssl rand -hex 32
# Hex, not base64: base64 emits + / and =, all of which need percent-encoding
# inside a postgres://user:pass@host string, and the failure looks exactly like
# a wrong password. See docs/deploy.md.
POSTGRES_PASSWORD=
POSTGRES_USER=basketwatch
POSTGRES_DB=basketwatch
POSTGRES_PORT_PUBLIC=55432

# What the Bright Data account held when last checked. The credit meter on the
# dashboard subtracts recorded spend from this; unset, it falls back to the
# daily ceiling rather than guessing an account total.
BD_BALANCE_USD=26

# Catalogue pulls. Off by default: the schedule is the only bound on a
# scheduled run, since it does not pass through lab/scripts/bd.mjs. Arm it
# deliberately, and only once the team agrees to start the history clock.
PULL_SCHEDULE_ENABLED=false
PULL_SCHEDULE_CRON=0 6 * * *

# The auto-heal loop. On by default -- this is the behaviour the product is
# built around, and the flag is a stop button rather than a gate. Setting it
# false still opens incidents and still shows them on the dashboard; what it
# skips is the Bright Data call that spends credits.
#
# Both this and PULL_SCHEDULE_ENABLED are read as words, not truthiness:
# true/1/yes/on and false/0/no/off. Anything else fails the boot.
HEAL_AUTO_ENABLED=true

# With auto-heal on, a proposal whose preview sample passes validation against
# the store baseline is approved by the machine and verified with one canary
# pull; a failing preview is rejected and re-proposed up to the per-incident
# cap, then held for a person. false = every proposal waits for a human, as
# before. Read as words, same as the flags above.
HEAL_AUTO_APPROVE_ENABLED=true

# Heal budget guard. Attempts-per-incident is the auto loop's proposal cap:
# original plus one retry, then the incident is held for a human.
HEAL_MAX_ATTEMPTS_PER_INCIDENT=2
HEAL_MAX_PER_SCRAPER_PER_DAY=5
CREDIT_DAILY_CEILING_USD=5

# Credit caps enforced by scripts/bd.mjs, the guarded Bright Data wrapper.
# Breaching one before an action refuses to run it; breaching a per-action
# cap after the fact exits non-zero so a loop stops. Bandwidth is the early
# warning: Bright Data's dollar figures round to cents and lag by minutes,
# but an unbounded crawl shows up in MB straight away.
BD_MAX_PER_ACTION_USD=0.25
BD_MAX_PER_ACTION_MB=50
BD_MAX_PER_HOUR_USD=1
BD_MIN_BALANCE_USD=20
# Seconds to wait for usage to settle before measuring. Worth setting for
# scraper create and heal, where the cost matters immediately.
BD_SETTLE_MS=0
