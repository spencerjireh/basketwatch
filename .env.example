# Two files at the repo root, and no per-app copies - a second copy per app is
# how drizzle-kit silently ran with no DATABASE_URL for a day.
#
#     .env       what you are working against. LOCAL by default.
#     .env.prod  the deployed database. Read only by `just db-backup` and by
#                anything you deliberately point at production. Gitignored.
#
#     cp .env.example .env
#
# The default is local on purpose. A command run without thinking should hit
# localhost; reaching production should require naming the file that says so.
#
# Ops actions that cost money or change the fleet (manual runs, heal triggers).
#
# The API only. The dashboard must never hold this: it has no login, so a token
# in the web container turns every visitor into an operator using our
# credentials. Prod compose passes it to `api` and not to `web`, and turbo does
# not forward it to the web dev server either.
#
# The guard fails closed: unset means those endpoints 401 and manual runs are
# off, which is a safe default rather than a broken one. Generate with
# `openssl rand -hex 32` and set it in the repo-root .env and in Coolify.
OPS_TOKEN=

# API logging
LOG_LEVEL=info

# Database (local dev, matches docker-compose.dev.yml at the repo root)
DATABASE_URL=postgres://basketwatch:basketwatch@localhost:5432/basketwatch

# The deployed database goes in .env.prod, not here. Use the public port and
# the password from the Coolify env.
#
# The raw VPS IP, not a hostname: *.spencerjireh.com is Cloudflare-proxied and
# the proxy does not forward Postgres traffic.
#
#     # .env.prod
#     DATABASE_URL=postgres://basketwatch:<password>@<vps-ip>:55432/basketwatch
#     POSTGRES_PASSWORD=<password>

# Alerts
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Prod compose (Coolify env). POSTGRES_PASSWORD has no default and the deploy
# fails without it; generate one with: openssl rand -hex 32
# Hex, not base64: base64 emits + / and =, all of which need percent-encoding
# inside a postgres://user:pass@host string, and the failure looks exactly like
# a wrong password.
POSTGRES_PASSWORD=
POSTGRES_USER=basketwatch
POSTGRES_DB=basketwatch
POSTGRES_PORT_PUBLIC=55432

# Catalogue pulls. Off by default: the schedule is the only bound on a
# scheduled run. Arm it deliberately, and only once the team agrees to start
# the history clock.
#
# Read as words, not truthiness: true/1/yes/on and false/0/no/off. Anything
# else fails the boot.
PULL_SCHEDULE_ENABLED=false
PULL_SCHEDULE_CRON=0 6 * * *

# ------------------------------------------------------------------------------
# Parker's Pantry (the clone store, apps/pantry)
# ------------------------------------------------------------------------------

# Guards the layout-mutation switch (POST /admin/layout) on the clone store.
# Generate with `openssl rand -hex 32` and set in the Coolify env. Unset, the
# switch answers 503 and the storefronts still serve.
PANTRY_ADMIN_TOKEN=

# Boot layout for the storefront: a (default) or b (the mutation). Runtime
# flips go through the admin switch instead; this only matters after a restart.
PANTRY_LAYOUT=a
