# Every secret in this repo lives in ONE file: `.env` at the repo root, beside
# this one. Both compose files read it, and so do drizzle-kit and the scripts in
# scrape-verse/. There is deliberately no per-app .env - a second copy is how
# drizzle-kit silently ran with no DATABASE_URL for a day.
#
#     cp .env.example .env
#
# Bright Data
BRIGHTDATA_API_KEY=
BRIGHTDATA_WEBHOOK_SECRET=

# Anthropic (heal prompt composition)
ANTHROPIC_API_KEY=

# Database (local dev, matches docker-compose.dev.yml at the repo root)
DATABASE_URL=postgres://basketwatch:basketwatch@localhost:5432/basketwatch

# To point at the deployed database instead, use the public port and the
# password from the Coolify env. See docs/deploy.md.
# The raw VPS IP, not a hostname: *.spencerjireh.com is Cloudflare-proxied and
# the proxy does not forward Postgres traffic. See docs/deploy.md.
# DATABASE_URL=postgres://basketwatch:<password>@152.53.136.253:55432/basketwatch

# Alerts
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Prod compose (Coolify env). POSTGRES_PASSWORD has no default and the deploy
# fails without it; generate one with: openssl rand -hex 32
# Hex, not base64: base64 emits + / and =, all of which need percent-encoding
# inside a postgres://user:pass@host string, and the failure looks exactly like
# a wrong password. See docs/deploy.md.
POSTGRES_PASSWORD=
POSTGRES_USER=basketwatch
POSTGRES_DB=basketwatch
POSTGRES_PORT_PUBLIC=55432
CLONE_ADMIN_TOKEN=

# Heal budget guard
HEAL_MAX_ATTEMPTS_PER_INCIDENT=3
HEAL_MAX_PER_SCRAPER_PER_DAY=5
CREDIT_DAILY_CEILING_USD=5
