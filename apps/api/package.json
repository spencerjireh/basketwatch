{
  "name": "@basketwatch/api",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "files": [
    "dist",
    "drizzle",
    "package.json"
  ],
  "scripts": {
    "dev": "sh scripts/dev.sh",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist .turbo",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@basketwatch/contract": "workspace:*",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/throttler": "^6.5.0",
    "drizzle-orm": "^0.45.2",
    "nestjs-pino": "^4.4.0",
    "pg-boss": "^11.1.2",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@basketwatch/eslint-config": "workspace:*",
    "@basketwatch/tsconfig": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "catalog:",
    "pino-pretty": "^13.1.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
