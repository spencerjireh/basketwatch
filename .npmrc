# node-linker is deliberately left at the default (isolated). Strict resolution
# catches a missing dependency at install time instead of inside a Docker build.
# The Docker story does not need hoisting: the api image uses `pnpm deploy` and
# the web image uses Next's standalone output, neither of which ships symlinks.
#
# EMERGENCY LEVER ONLY: setting node-linker=hoisted fixes pnpm-in-Docker in one
# line and silently reintroduces phantom dependencies -- a package resolves
# locally because something else hoisted it, then fails in a pruned image.
engine-strict=true
strict-peer-dependencies=false
