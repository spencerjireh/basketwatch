# cached HTTP probe responses - regenerable, 100MB+, and site content we do not own
raw/
*.log
__pycache__/
# in-flight Studio create output, superseded by registry.json
studio-*.json
# ...but NOT the collector registry. This pattern silently swallowed it, and is the
# most plausible reason the first three collectors' creation descriptions were lost:
# there is no `scraper list` in the CLI, so this file is the only store-to-collector
# mapping that exists. Verified with `git check-ignore` before adding this line.
!studio-collectors.json
# catalogue payloads are large and regenerable; runs.jsonl and changes.jsonl are the
# durable record and stay tracked
catalogue/*.json
# development-era run/change logs, kept locally for reference only
catalogue/*.dev.jsonl
# migration safety copy
catalogue.bak/
