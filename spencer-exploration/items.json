{
  "_comment": "The tracked item registry. Items, units and match rules live here, not in code, so adding an item or a country is a data edit. basket.py reads this file.",
  "spec_version": 1,
  "basis": {
    "measurement_design": "Matched-model pinning, following BLS and PSA: one specific product per generic item per store, repriced every run. Substitution is never silent.",
    "selection_criteria": [
      "Expenditure weight of the group (CPI Manual; ONS)",
      "Price variability between candidate items within the group - divergent groups get more items (ONS)",
      "Representativeness of the wider group",
      "Continuous availability, so the item can be repriced period after period",
      "Precise specification - type and container size fixed, so it is the same thing each period (BLS)",
      "Publicly catalogued on the store site - our binding constraint, not a statistical one",
      "Size parseable from the product title, since unit price must be computed rather than captured"
    ],
    "weights_source": "Philippine FIES 2018: food is 42.6% of family spending, 33.6% at home. Within at-home food, bread and cereals 11.0%, meat 5.7%, fish and seafood 5.0%.",
    "comparability_note": "Units mirror Numbeo's published specs wherever an item overlaps, so their figures remain usable as an external sanity check. Numbeo is a cross-check only, never a data source.",
    "tiers": {
      "core": "The docs/prd.md section 5 basket, unchanged. Powers the headline index, so nothing already built is invalidated.",
      "stretch": "Broadens the tool from a basket index into a price checker. Per-store gaps are acceptable here."
    }
  },
  "base_units": {
    "mass": "g",
    "volume": "ml",
    "count": "count"
  },
